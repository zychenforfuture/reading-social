# 环境变量配置模板
# 复制此文件为 .env 并填写实际值后使用

# ===========================================
# 数据库配置
# ===========================================
# 数据库密码（建议使用强密码）
DB_PASSWORD=your_secure_db_password_here

# PostgreSQL 数据库连接字符串
# 格式：postgresql://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgresql://admin:your_secure_db_password_here@localhost:5432/collab_comments

# ===========================================
# Redis 配置
# ===========================================
# Redis 密码（建议使用强密码）
REDIS_PASSWORD=your_secure_redis_password_here

# Redis 连接字符串
# 格式：redis://:密码@主机:端口
REDIS_URL=redis://:your_secure_redis_password_here@localhost:6379

# ===========================================
# JWT 配置
# ===========================================
# JWT 签名密钥（必须使用随机生成的强密钥，至少 32 字符）
# 生成方法：openssl rand -hex 32 或 openssl rand -base64 32
# 启动时会验证复杂度，包含长度、熵值和弱模式检查
JWT_SECRET=your_secure_jwt_secret_here_at_least_32_chars

# ===========================================
# 前端配置
# ===========================================
# 前端访问地址（不带末尾斜杠）
FRONTEND_URL=http://localhost:5173

# ===========================================
# 管理员配置（可选）
# ===========================================
# 初始管理员账号（首次启动若该邮箱不存在则自动创建，留空则跳过）
ADMIN_INIT_EMAIL=admin@example.com
ADMIN_INIT_USERNAME=admin
ADMIN_INIT_PASSWORD=Admin123456!

# 管理员邮箱列表（逗号分隔，多个地址用英文逗号隔开）
# 示例：ADMIN_EMAILS=admin@example.com,another@example.com
ADMIN_EMAILS=admin@example.com

# ===========================================
# SMTP 邮件配置（用于发送注册/重置密码验证码）
# ===========================================
# SMTP 服务器地址
SMTP_HOST=smtpdm.aliyun.com

# SMTP 服务器端口
SMTP_PORT=465

# SMTP 用户名
SMTP_USER=your_smtp_username

# 发件人邮箱地址
SMTP_FROM=noreply@yourdomain.com

# SMTP 密码
SMTP_PASS=your_smtp_password